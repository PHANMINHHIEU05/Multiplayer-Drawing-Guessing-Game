:80 {
	encode zstd gzip

	@websocket path /ws /ws/*
	handle @websocket {
		reverse_proxy realtime-gateway:8080 realtime-gateway-2:8080 {
			lb_policy round_robin
			lb_try_duration 3s
			health_uri /actuator/health
			health_interval 10s
			health_timeout 2s
			health_fails 2
			fail_duration 10s
			max_fails 1
		}
	}

	handle {
		reverse_proxy frontend:80
	}
}
