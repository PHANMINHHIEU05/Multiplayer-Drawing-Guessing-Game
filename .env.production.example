# Replace the sample domain with the DNS name that will point to the EC2 Elastic IP.
APP_DOMAIN=game.example.com

POSTGRES_DB=drawgame
POSTGRES_USER=drawgame
POSTGRES_PASSWORD=REPLACE_WITH_A_UNIQUE_RANDOM_PASSWORD

# Generate with: openssl rand -base64 48
GAME_SESSION_JWT_SECRET=REPLACE_WITH_OUTPUT_FROM_OPENSSL
GAME_SESSION_TOKEN_TTL_MINUTES=720

# Must exactly match the HTTPS origin for APP_DOMAIN, with no trailing slash.
WS_ALLOWED_ORIGINS=https://game.example.com
