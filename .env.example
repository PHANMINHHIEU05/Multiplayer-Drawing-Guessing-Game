POSTGRES_DB=drawgame
POSTGRES_USER=drawgame
POSTGRES_PASSWORD=your_password

POSTGRES_PORT=5432
REDIS_PORT=6379

# TV8 security: shared game-session JWT secret — BOTH gateways must use the SAME value.
# Generate e.g.: openssl rand -base64 48
GAME_SESSION_JWT_SECRET=change_me_to_a_long_random_secret
# Game session credential lifetime (minutes). 720 = a full long game session.
GAME_SESSION_TOKEN_TTL_MINUTES=720
# WebSocket origin allowlist (comma-separated). Empty in dev = localhost-only.
# Production example: https://drawgame.example.com,https://www.drawgame.example.com
WS_ALLOWED_ORIGINS=
# TV10 failover: comma-separated Gateway endpoint pool for the browser.
# Empty/single value keeps single-endpoint behavior (reverse-proxy friendly).
VITE_WS_URLS=ws://localhost:8080/ws,ws://localhost:8090/ws

# TV12 WebRTC Voice Chat: STUN/TURN server configuration
VITE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# Optional TURN server configuration for NAT traversal behind symmetric NATs
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Optional coturn profile configuration (if running `docker compose --profile turn up`)
TURN_REALM=drawgame.local
TURN_USERNAME=drawgame
TURN_CREDENTIAL=drawgamepassword
TURN_MIN_PORT=49152
TURN_MAX_PORT=49200
